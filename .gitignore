# ---------------------------------------------------------------------------
# Secrets and local configuration — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
appsettings.[Ll]ocal.json
appsettings.*.[Ll]ocal.json
secrets.json

# Docker Compose loads these automatically; they hold machine-specific ports
# and credentials. Commit shared changes to compose.yaml instead.
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

# Local databases and data dumps
*.db
*.db-journal
*.sqlite
*.sqlite3
*.dump
*.backup
*.bak
pgdata/

# ---------------------------------------------------------------------------
# Node.js / Next.js (apps/web)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
dist/
next-env.d.ts
*.tsbuildinfo
.vercel/
.turbo/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test output and browser-test artifacts
coverage/
playwright-report/
test-results/
blob-report/
**/playwright/.cache/
# Saved sign-in state from Playwright setup projects contains session cookies.
**/playwright/.auth/

# ---------------------------------------------------------------------------
# .NET (backend)
# ---------------------------------------------------------------------------
# Scoped to backend/ so that folders named bin, log or artifacts stay
# available for source elsewhere in the monorepo.
backend/**/[Bb]in/
backend/**/[Oo]bj/
backend/**/[Ll]ogs/
backend/artifacts/
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
*.nupkg
*.snupkg
BenchmarkDotNet.Artifacts/
# MSBuild binary logs record environment variables, which can include secrets.
*.binlog
# Repository-local SDK installs from dotnet-install scripts
.dotnet/

# ---------------------------------------------------------------------------
# IDE and editor state
# ---------------------------------------------------------------------------
.vs/
.idea/
.fleet/
*.iml
*.user
*.suo
*.rsuser
*.userprefs
*.DotSettings.user
_ReSharper*/
**/.vscode/*
!**/.vscode/extensions.json
.history/
*.code-workspace
*.swp
*.swo
*~
**/.claude/settings.local.json

# ---------------------------------------------------------------------------
# Operating systems
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.directory

# ---------------------------------------------------------------------------
# Logs, caches and temporary files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.temp
.tmp/
.cache/
