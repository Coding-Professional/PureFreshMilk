# Local development settings for compose.yaml and scripts/run-api.*.
# Copy to .env (git-ignored) and fill in. Placeholders only: never commit a real .env.
# Use plain values without quotes, and avoid ";" in the password (it ends a connection-string field).

POSTGRES_DB=milkmanager
POSTGRES_USER=milkmanager
# Required. Choose any password for your local database container.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
