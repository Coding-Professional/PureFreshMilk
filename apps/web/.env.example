# Copy to .env.local (git-ignored) and adjust. Placeholders only — never commit real values.

# Base URL of the ASP.NET Core API, without a trailing slash or /api/v1.
# Optional: the web app works without the API. Then Today and Recipients show labelled demo data, and
# Settings says it needs the API. With an address, Recipients and Settings use the API's data.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
